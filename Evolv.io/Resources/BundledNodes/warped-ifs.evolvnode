// warped-ifs: ifs with u and v in place of the pixel coordinates (1991
// paper, section 4.1; Figure 12 calls it as (warped-ifs (round y y) y ...)).
// Like the warped noise nodes, each channel uses its own (u, v) pair. The
// other 16 arguments are ifs's -- see ifs-core.evolvnode.
node "warped-ifs"(u, v, a0: scalar, a1: scalar, a2: scalar, a3: scalar, a4: scalar, a5: scalar, a6: scalar, a7: scalar, a8: scalar, a9: scalar, a10: scalar, a11: scalar, a12: scalar, a13: scalar, a14: scalar, a15: scalar) -> scalar requires("ifs-core") {
	return float3(
		ifsEscape(float2(u.x, v.x), a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15),
		ifsEscape(float2(u.y, v.y), a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15),
		ifsEscape(float2(u.z, v.z), a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15)
	)
}
