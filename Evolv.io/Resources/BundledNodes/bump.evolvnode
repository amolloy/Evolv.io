// Height-field bump: differentiates source (scaled per channel by
// multiplier, then reduced to luminance) with a central difference, builds
// the normal (-strength*gx, -strength*gy, 1), lights it Lambert-style
// (max(dot, 0)) from (dirX, dirY, lightHeight), and blends
// color1 -> color2 by the result. The argument mapping is still a
// best-effort reconstruction (Bump.md #5/#6); since Bump.md #8 the light's
// height is the first of the three trailing scalars, not the last, which
// puts a flat surface near color1 (Figure 12's browns below the horizon).
node "bump"(source: fn taps(abs($debugDelta)), multiplier, strength: scalar, color1: vector, color2: vector, lightHeight: scalar, dirX: scalar, dirY: scalar) -> vector requires(lighting) {
	param $debugDelta: float = 0.01 debug slider(0.0, 0.2)
	let strengthVal: float = avgLum(strength)
	let d: float = $debugDelta
	let hxp: float = avgLum(source(coord + float2(d, 0.0)) * multiplier)
	let hxm: float = avgLum(source(coord - float2(d, 0.0)) * multiplier)
	let hyp: float = avgLum(source(coord + float2(0.0, d)) * multiplier)
	let hym: float = avgLum(source(coord - float2(0.0, d)) * multiplier)
	let gx: float = (hxp - hxm) / (2.0 * d)
	let gy: float = (hyp - hym) / (2.0 * d)
	let n = normalize(float3(-gx * strengthVal, -gy * strengthVal, 1.0))
	let lightRaw = float3(avgLum(dirX), avgLum(dirY), avgLum(lightHeight))
	let lightLen: float = length(lightRaw)
	let l = (lightLen < 1e-9) ? float3(0.0, 0.0, 1.0) : lightRaw / lightLen
	let t: float = clamp(dot(n, l), 0.0, 1.0)
	return mix(color1, color2, t)
}
