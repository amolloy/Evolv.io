// blur: Gaussian blur of source with a radius in *pixels*, as in Sims'
// Figure 13, (blur <source> 3.1). The CM-2 held one pixel per processor,
// so a blur there is a neighbour average in pixel units (repeated 3x3
// averages approach a Gaussian). Our coordinates are resolution-independent
// (-1...1 across the width), so a pixel is 2 / $debugImageWidth, with 256
// (a 64K-processor CM-2 as a 256x256 grid) as the default.
//   radius: Gaussian sigma = radius * $debugSigmaScale pixels, so Figure 13's
//   3.1 is a sigma of 3.1 CM-2 pixels. (The scale was 0.5 until Figure 13's
//   probes: at 0.5 the blur barely showed; 1 softens the embossed worms
//   toward Sims' original; 2 over-softens.)
// Emulates the CM-2 grid: the blur is computed at the four CM-2 pixel
// centres around coord, each from source point-sampled at pixel centres on
// a 21x21 grid of taps one pixel apart (+/-10 pixels, which covers +/-3
// sigma up to sigma 3.33; larger sigmas space the taps a whole number of
// pixels apart), and interpolated bilinearly between them, like upscaling
// the CM-2's image. Weights are normalized. Figure 13's cross-hatch came from
// sparser taps at arbitrary offsets: blurring its hard-edged `if` mask that
// way stacks shifted copies of every edge, and grad-direction turns each
// step into a line. Taps one pixel apart without the grid reduced it; the
// grid removes it. The result depends on $debugImageWidth, since the source
// is sampled only at CM-2 pixel centres. See Documentation/Figure13.md.
node "blur"(source: fn, radius: scalar) {
	param $debugImageWidth: float = 256.0 debug slider(64.0, 1024.0)
	param $debugSigmaScale: float = 1.0 debug slider(0.0, 2.0)
	let px: float = 2.0 / $debugImageWidth
	let sigmaPx: float = abs((radius.x + radius.y + radius.z) / 3.0) * $debugSigmaScale
	let stepPx: float = max(ceil(sigmaPx * 3.0 / 10.0), 1.0)
	let invTwoSigma2: float = (sigmaPx > 1e-6) ? 1.0 / (2.0 * sigmaPx * sigmaPx) : 1e6
	let g: float2 = coord / px - float2(0.5)
	let g0: float2 = floor(g)
	let f: float2 = g - g0
	let wsum: float = average(j in 0...20) {
		average(k in 0...20) {
			let o: float2 = float2(float(k - 10), float(j - 10)) * stepPx
			exp(-dot(o, o) * invTwoSigma2)
		}
	}
	let acc = average(b in 0...1) {
		average(a in 0...1) {
			let cell: float2 = (g0 + float2(float(a), float(b)) + float2(0.5)) * px
			let wa: float = (a == 0) ? 1.0 - f.x : f.x
			let wb: float = (b == 0) ? 1.0 - f.y : f.y
			let s = average(j in 0...20) {
				average(k in 0...20) {
					let o: float2 = float2(float(k - 10), float(j - 10)) * stepPx
					source(cell + o * px) * exp(-dot(o, o) * invTwoSigma2)
				}
			}
			s * (wa * wb * 4.0)
		}
	}
	return acc / wsum
}
