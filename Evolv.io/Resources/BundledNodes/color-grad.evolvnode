// The active "color-grad" node -- ported off the hand-written
// ExpressionTree/Nodes/ColorGradient.swift, which has been deleted now
// that this file replaces it in NodeRegistry (see the "swap dsl-* for the
// legacy nodes" change). Tunables that were ColorGradient.debugDelta/etc
// are hardcoded literals here (0.01/20.0/0.0/4) -- there's no live-tuning
// UI anymore (ColorGradientDebugView was retired alongside this swap;
// its whole premise -- mutating Swift statics the render path reads live
// -- doesn't apply to a text file baked at parse time). To tune these now,
// edit the literals directly and use "Reload Custom Nodes".
node "color-grad"(source: fn, p1, p2, color, p3) requires(lighting) {
	let p1Val: float = avgLum(p1)
	let deltaLocal: float = (abs(p1Val) / 3.1) * 0.01

	let p3Val: float = avgLum(p3)
	let heightFactor: float = p3Val * 20.0
	let lightZ: float = p3Val * 0.0

	let angle: float = avgLum(p2)

	let gx = average(i in 1...4) {
		let radius: float = deltaLocal * (float(i) / float(4))
		source(coord - float2(radius, 0.0)) - source(coord + float2(radius, 0.0))
	}
	let gy = average(i in 1...4) {
		let radius: float = deltaLocal * (float(i) / float(4))
		source(coord - float2(0.0, radius)) - source(coord + float2(0.0, radius))
	}

	let lightDx: float = cos(angle)
	let lightDy: float = sin(angle)
	let lightDir = float3(lightDx, lightDy, lightZ)
	let lightLen: float = length(lightDir)
	let lightNormalized = lightDir / lightLen

	let lightMap = (lightLen < 1e-9) ? float3(0.5) : float3(colorGradChannel(gx.x, gy.x, heightFactor, lightNormalized, color.x), colorGradChannel(gx.y, gy.y, heightFactor, lightNormalized, color.y), colorGradChannel(gx.z, gy.z, heightFactor, lightNormalized, color.z))

	return signedPow(lightMap, p3Val)
}
