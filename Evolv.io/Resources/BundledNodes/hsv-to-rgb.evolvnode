// Hue is read in sextants (0...6, one unit per 60 degrees), not 0...1.
// Figure 13's hsv-to-rgb inputs are noise near 0.51: as 0...1 hue that is
// teal, which gives salmon/teal where Sims has brown/blue; as sextants it is
// orange (R > G > B), which gives the brown/blue family. Figure 10 is almost
// unchanged.
node "hsv-to-rgb"(hsv: vector) -> vector {
	let h: float = fmod(hsv.x, 6.0)
	let s: float = hsv.y
	let v: float = hsv.z
	let c: float = v * s
	let x: float = c * (1.0 - abs(fmod(h, 2.0) - 1.0))
	let m: float = v - c

	let rgb = (int(h) == 0) ? float3(c, x, 0.0) :
		(int(h) == 1) ? float3(x, c, 0.0) :
		(int(h) == 2) ? float3(0.0, c, x) :
		(int(h) == 3) ? float3(0.0, x, c) :
		(int(h) == 4) ? float3(x, 0.0, c) :
		(int(h) == 5) ? float3(c, 0.0, x) :
		float3(0.0, 0.0, 0.0)

	return rgb + float3(m)
}
