// color-noise: the last argument is the octave count (see octaves.evolvnode);
// the channels use fixed permutation offsets 0, 1 and 2.
node "color-noise"(e0, e1) requires(perlin, octaves) {
	let v0 = e0 * 50.0
	return float3(
		octaveNoise(coord * v0.x, 0, e1.x),
		octaveNoise(coord * v0.y, 1, e1.y),
		octaveNoise(coord * v0.z, 2, e1.z)
	)
}
