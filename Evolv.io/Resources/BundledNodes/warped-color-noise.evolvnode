// warped-color-noise: the last argument is the octave count (see octaves.evolvnode);
// the channels use fixed permutation offsets 0, 1 and 2.
// u and v replace the pixel coordinates (1991 paper, section 4.1, and
// Figure 4i's stretched bands for (warped-color-noise (* X .2) Y .1 2)).
node "warped-color-noise"(u, v, e2: scalar, e3: scalar) -> vector requires(perlin, octaves) {
	return noiseChannels(float2(u.x, v.x), float2(u.y, v.y), float2(u.z, v.z), e2, e3, 1)
}
